---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WritingList from '../components/WritingList.astro';
import ProjectList from '../components/ProjectList.astro';
import { sortNewestFirst } from '../lib/writing.mjs';

// Only the three newest pieces go on the homepage, so the section keeps a fixed
// height as pieces accumulate. The full list lives at /writing/.
const pieces = sortNewestFirst(await getCollection('writing')).slice(0, 3);

const projects = [
  {
    name: 'Agora',
    description: 'A web server written in Rust using only the standard library.',
    tags: ['Rust'],
    href: 'https://github.com/ruro122020/Agora',
  },
  {
    name: 'PostgreSQL driver benchmark',
    description: 'A timing comparison of the asyncpg and psycopg2 PostgreSQL drivers under Django.',
    tags: ['Python', 'PostgreSQL', 'Django'],
    href: 'https://github.com/ruro122020/pg-driver-performance',
  },
  {
    name: 'AnimalsMD',
    description: 'A Flask REST API that matches a pet\'s symptoms to possible illnesses and returns treatments and products.',
    tags: ['Python', 'Flask', 'PostgreSQL'],
    href: 'https://github.com/ruro122020/animalsmd-backend-2.0',
  },
];
---

<BaseLayout
  title="kmalloc | Ruth Rojas"
  description="Ruth Rojas, systems engineer. Distributed systems, Go (Golang), and embedded software."
>
    <!-- HERO -->
    <section id="hero">
      <div class="hero-text reveal">
        <h1>My Little Slice of the Web<em style="font-style:italic;color:var(--accent)">.</em></h1>
        <p class="hero-tagline">Welcome to my space, where I write about the things I find interesting and the things I like working on.</p>
        <p class="hero-tagline">I'm currently on a mission to build a <a href="https://github.com/ruro122020/Agora" target="_blank" rel="noopener noreferrer">web server</a> and host it on a Raspberry Pi wired to a microcontroller running an RTOS. The web server is there so I can use an <a href="https://github.com/ruro122020/Agora" target="_blank" rel="noopener noreferrer">API</a> to send execution commands from wherever I am over a private network. I'm using Rust because it's the language I've enjoyed learning the most. From what I hear, I'll be setting myself up not to like any other compiled language afterwards, but I think I'm okay with that! 🤭</p>
      </div>
    </section>

    <!-- WRITING -->
    <section id="writing" class="writing-section" style="padding-top:0;padding-bottom:5rem">
      <div class="home-columns">
        <div>
          <div class="writing-archive reveal">
            <a href="/writing/" class="writing-archive-link">All writing <span aria-hidden="true">→</span></a>
          </div>
          <WritingList pieces={pieces} />
        </div>
        <div class="home-projects">
          <div class="section-label reveal">Projects</div>
          <ProjectList projects={projects} />
        </div>
      </div>
    </section>
</BaseLayout>
