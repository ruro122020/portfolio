---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WritingList from '../components/WritingList.astro';
import { sortNewestFirst } from '../lib/writing.mjs';

// Only the three newest pieces go on the homepage, so the section keeps a fixed
// height as pieces accumulate. The full list lives at /writing/.
const pieces = sortNewestFirst(await getCollection('writing')).slice(0, 3);
---

<BaseLayout
  title="kmalloc | Ruth Rojas"
  description="Ruth Rojas, systems engineer. Distributed systems, Go (Golang), and embedded software."
>
    <!-- HERO -->
    <section id="hero">
      <div class="hero-text reveal">
        <h1>Systems<br /><em>Engineer</em><br />&amp; Builder.</h1>
        <p class="hero-tagline">I build APIs that interact with the operating system and distribute automation to run hardware tests. I'm learning my way into embedded software, with robotics engineering as the goal.</p>
        <div class="hero-ctas">
          <a href="#projects" class="btn-primary" data-scroll="projects">View Projects</a>
          <a href="#contact" class="btn-ghost" data-scroll="contact">Get in Touch</a>
        </div>
      </div>
      <div class="hero-aside reveal">
        <div class="hero-stat-block">
          <div class="stat-row"><span class="stat-label">Focus</span><span class="stat-value">Systems &amp; Automation</span></div>
          <div class="stat-row"><span class="stat-label">Currently learning</span><span class="stat-value">RTOS / Embedded</span></div>
          <div class="stat-row"><span class="stat-label">Stack</span><span class="stat-value">Go (Golang) &middot; Python</span></div>
          <div class="stat-row" style="border-bottom:none;padding-bottom:0"><span class="stat-label">Status</span><span class="availability-badge">Open to roles</span></div>
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <hr class="section-divider" />
    <section id="projects">
      <div class="section-label reveal">Work</div>
      <h2 class="reveal">Things I've built.</h2>
      <p class="section-intro reveal">Real problems that needed solving, built in production under real constraints.</p>
      <div class="projects-grid" id="projectsGrid" style="margin-bottom:4rem;grid-template-columns:1fr"></div>
      <div class="section-label reveal" style="margin-top:1rem">Side Projects</div>
      <h3 class="reveal" style="font-family:var(--serif);font-size:clamp(1.4rem,3vw,2rem);font-weight:300;letter-spacing:-0.02em;margin-bottom:0.5rem">Things I've built to learn.</h3>
      <p class="section-intro reveal">Projects I took on specifically to understand something new, scoped small and built deliberately.</p>
      <div class="projects-grid" id="sideProjectsGrid" style="gap:1.5rem;background:transparent;border:none"></div>
    </section>

    <!-- RESUME -->
    <hr class="section-divider" />
    <section id="resume">
      <div class="section-label reveal">Resume</div>
      <h2 class="reveal" style="font-family:var(--serif);font-size:clamp(2rem,4vw,3rem);font-weight:300;letter-spacing:-0.02em;margin-bottom:0.5rem">Experience.</h2>
      <p class="section-intro reveal" style="color:var(--ink-muted);max-width:560px;margin-bottom:1.5rem">Full Resume available as a PDF.</p>
      <a href="/Ruth_Rojas_Resume.pdf" class="btn-primary reveal" style="display:inline-block" download>Download Resume (PDF)</a>
      <div class="reveal" style="margin-top:3.5rem">
        <div class="section-label" style="margin-bottom:2rem">Skills</div>
        <div id="skillsGrid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2rem"></div>
      </div>
    </section>

    <!-- LEARNING -->
    <section id="learning" style="max-width:100%">
      <div>
        <div class="section-label reveal">Currently learning</div>
        <h2 class="reveal">Active learning log.</h2>
        <p class="section-intro reveal">Things I'm studying right now, with an honest read on how deep in I am.</p>
        <div class="learning-list" id="learningList"></div>
      </div>
    </section>

    <!-- WRITING -->
    <hr class="section-divider" />
    <section id="writing" class="writing-section">
      <div class="section-label reveal">Writing</div>
      <h2 class="reveal">Technical writing.</h2>
      <p class="section-intro reveal">I write to understand things better. Breakdowns and opinions on the systems I'm building and studying.</p>
      <div class="writing-archive reveal">
        <a href="/writing/" class="writing-archive-link">All writing <span aria-hidden="true">→</span></a>
      </div>
      <WritingList pieces={pieces} />
    </section>

    <!-- ABOUT + CONTACT -->
    <hr class="section-divider" />
    <section id="about" style="display:block;padding:7rem 4rem">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:4rem;align-items:start">
        <div>
          <div class="section-label reveal">About</div>
          <h2 class="reveal" style="font-family:var(--serif);font-size:clamp(2rem,4vw,3rem);font-weight:300;letter-spacing:-0.02em;margin-bottom:1.5rem">Who I am.</h2>
          <p class="about-bio reveal">I'm a systems engineer working at the boundary between <strong>software and hardware</strong>.
            I'm self-studying <strong>RTOS internals and embedded systems</strong> with the goal of understanding how real-time constraints work at the hardware level.
            I care about systems that have to work in the real world, under real constraints. My dream is to one day work as a robotics engineer.</p>
          <div class="about-links reveal">
            <a href="https://github.com/ruro122020" class="about-link" target="_blank" rel="noopener noreferrer"><span class="about-link-icon">&#8599;</span> GitHub</a>
            <a href="https://www.linkedin.com/in/ruth-tech-dev" class="about-link" target="_blank" rel="noopener noreferrer"><span class="about-link-icon">&#8599;</span> LinkedIn</a>
            <a href="/Ruth_Rojas_Resume.pdf" class="about-link" download><span class="about-link-icon">&#8595;</span> Download Resume (PDF)</a>
          </div>
        </div>
        <div style="min-width:0">
          <span id="contact" style="display:block;height:0"></span>
          <div class="reveal">
            <div class="contact-block" style="box-sizing:border-box;width:100%">
              <div class="contact-heading">Let's talk.</div>
              <p class="contact-text">Open to full-time roles and conversations about the work I do: building APIs that talk to the operating system and push automation out to machines to run hardware tests. Also moving into embedded software. Response time is usually same day.</p>
              <a href="mailto:ruro122020@gmail.com" class="contact-email" style="word-break:break-all">ruro122020@gmail.com</a>
              <a href="mailto:ruro122020@gmail.com" class="btn-primary" style="display:inline-block">Send an email</a>
            </div>
          </div>
        </div>
      </div>
    </section>
</BaseLayout>
