---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entrySlug } from '../../loaders/blog.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  // Slugs must be unique because they are the whole URL. Two notes with the
  // same filename in different folders collide; fail the build naming both.
  const seen = new Map();
  return posts.map((entry) => {
    const slug = entrySlug(entry.id);
    if (seen.has(slug)) {
      throw new Error(
        `duplicate blog slug "${slug}": entries "${seen.get(slug)}" and "${entry.id}" both map to /blog/${slug}/`
      );
    }
    seen.set(slug, entry.id);
    return { params: { slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
// YAML dates parse as UTC midnight; format in UTC too, or machines west of
// Greenwich would print the day before the one written in the frontmatter.
const formattedDate = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <section class="post">
    <article>
      <header class="post-header">
        <h1 class="post-title">{entry.data.title}</h1>
        <time class="post-date" datetime={entry.data.date.toISOString()}>{formattedDate}</time>
      </header>
      <div class="post-body">
        <Content />
      </div>
    </article>
  </section>
</BaseLayout>
