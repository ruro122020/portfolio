---
// Notes used to live at /blog/<slug>/. Those addresses are public, so they
// keep resolving and send the visitor to the new /writing/<slug>/ page.
//
// This is written by hand rather than with Astro's config `redirects` option
// on purpose. For a dynamic redirect, Astro builds the target with the
// destination route's generator, and that generator is constructed without
// `config.base`; nothing in the redirect render path adds the base back. On
// this site (base: '/portfolio') the emitted refresh would point at
// /writing/<slug>/ and 404 on GitHub Pages. Do not "simplify" this into the
// config option.
import { getCollection } from 'astro:content';
import { noteRoutes } from '../../lib/notes.mjs';
import { base } from '../../lib/site.mjs';

export async function getStaticPaths() {
  // Reuse the real pages' route list so the redirects can never drift from it.
  return noteRoutes(await getCollection('blog'));
}

const { slug } = Astro.params;const target = `${base}/writing/${slug}/`;
const canonical = new URL(target, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta http-equiv="refresh" content={`0;url=${target}`} />
<meta name="robots" content="noindex" />
<link rel="canonical" href={canonical} />
<title>Redirecting to {target}</title>
</head>
<body>
  <p>This note has moved. <a href={target}>Continue to its new address</a>.</p>
</body>
</html>
