---
// The list of pieces, rendered identically wherever it appears: the homepage
// Writing section and the /writing/ archive. Callers decide the order and how
// many to pass in; this only renders what it is given.
import { entrySlug, formatPieceDate } from '../lib/writing.mjs';

interface Props {
  pieces: { id: string; data: { title: string; description: string; date: Date } }[];
}

const { pieces } = Astro.props;
---

<div class="writing-list">
  {pieces.map((piece, i) => (
    <a href={`/writing/${entrySlug(piece.id)}/`} class="writing-item reveal" style={`transition-delay:${i * 0.07}s`}>
      <div class="writing-date">{formatPieceDate(piece.data.date)}</div>
      <div>
        <div class="writing-title">{piece.data.title}</div>
        <div class="writing-excerpt">{piece.data.description}</div>
      </div>
      <span class="writing-arrow">→</span>
    </a>
  ))}
</div>
