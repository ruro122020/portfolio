---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Astro.site is the domain root and Astro.url.pathname carries the trailing slash
// the build produces, so this is the exact address the page is served at.
const canonical = new URL(Astro.url.pathname, Astro.site);
const previewCard = new URL('/og.png', Astro.site);

// The desktop nav and the mobile drawer show the same links. Defining them once
// means they cannot drift apart. id is both the homepage anchor and the section
// main.js scrolls to, so the two always match.
const navItems = [
  { id: 'projects', label: 'Projects' },
  { id: 'resume', label: 'Resume' },
  { id: 'learning', label: 'Learning' },
  { id: 'writing', label: 'Writing' },
  { id: 'about', label: 'About' },
  { id: 'contact', label: 'Contact' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

{/* global.css imports the fonts, so the browser only learns these origins exist
    after it has parsed the stylesheet. crossorigin is required on the gstatic
    one: fonts are fetched in CORS mode, and without it the browser opens a
    connection it then discards. */}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="kmalloc" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={previewCard} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="kmalloc.dev. Ruth Rojas, systems engineer and builder." />
<meta name="twitter:card" content="summary_large_image" />

<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
</head>
<body>
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <!-- NAV -->
  <nav>
    <a href="/#hero" class="nav-logo" data-scroll="hero">Ruth<em style="font-style:italic;color:var(--accent)">.</em></a>
    <ul class="nav-links">
      {navItems.map(({ id, label }) => (
        <li><a href={`/#${id}`} data-scroll={id}>{label}</a></li>
      ))}
    </ul>
    <button class="hamburger" id="hamburger" aria-label="Toggle menu"><span></span><span></span><span></span></button>
  </nav>
  <ul class="nav-drawer" id="navDrawer">
    {navItems.map(({ id, label }) => (
      <li><a href={`/#${id}`} data-scroll={id}>{label}</a></li>
    ))}
  </ul>

  <main>
    <slot />
  </main>

  <footer>
    <span class="footer-copy">&copy; 2025 Ruth — Built with intention.</span>
    <a href="/#hero" class="footer-back" data-scroll="hero">&uarr; Back to top</a>
  </footer>

  <script is:inline src="/main.js"></script>
</body>
</html>
